{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "wrangler.toml",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        ".wrangler/**"
      ]
    },
    "lint": {
      "inputs": ["src/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}