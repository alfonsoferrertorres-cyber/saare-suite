{
  "routes": [
    {
      "routePath": "/v1/chat/completions",
      "mountPath": "/v1/chat",
      "method": "POST",
      "module": [
        "v1/chat/completions.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/engineer/config",
      "mountPath": "/api/engineer",
      "method": "",
      "module": [
        "api/engineer/config.js:onRequest"
      ]
    },
    {
      "routePath": "/api/v1/leads",
      "mountPath": "/api/v1",
      "method": "",
      "module": [
        "api/v1/leads.ts:onRequest"
      ]
    },
    {
      "routePath": "/api/checkout",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/checkout.js:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/checkout",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/checkout.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/deployments",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/deployments.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/deployments",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/deployments.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/license",
      "mountPath": "/api",
      "method": "",
      "module": [
        "api/license.ts:onRequest"
      ]
    },
    {
      "routePath": "/api/middleware",
      "mountPath": "/api",
      "method": "",
      "module": [
        "api/middleware.js:onRequest"
      ]
    },
    {
      "routePath": "/",
      "mountPath": "/",
      "method": "",
      "middleware": [
        "_middleware.js:onRequest"
      ]
    }
  ],
  "baseURL": "/"
}