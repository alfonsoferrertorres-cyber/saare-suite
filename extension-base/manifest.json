{
  "manifest_version": 3,
  "name": "S.A.A.R.E. L7 Sovereign Agent",
  "version": "8.2.0",
  "description": "Sensor perimetral L7 de inspección ex-ante en memoria RAM y atestación criptográfica.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://api.saare.es/*",
    "https://console.saare.es/*",
    "https://*.openai.com/*",
    "https://*.anthropic.com/*",
    "https://*.claude.ai/*",
    "https://*.google.com/*",
    "https://*.gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "S.A.A.R.E. L7 Witness Agent"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ]
}