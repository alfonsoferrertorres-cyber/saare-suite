{
  "name": "cloud-isv-desarrollo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:cloud": "pnpm --filter control-plane dev",
    "build": "turbo run build --ui=stream",
    "clean": "turbo run clean && rm -Recurse -Force .turbo, node_modules/.cache -ErrorAction SilentlyContinue",
    "lint": "turbo run lint",
    "resilience": "node scripts/resilienceGate_2.js",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./despliegue_maestro.ps1",
    "evidence:generate": "python scripts/generar_evidencia.py",
    "report:corporate": "python scripts/generar_informe_corporativo.py",
    "manual:iso42001": "python scripts/generar_manual_iso42001.py",
    "manual:policy-l7": "python scripts/generar_manual_policy_engine_l7.py",
    "secretaria:license": "pnpm --filter @saare/license-factory generate"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@12.11.2"
}