{
  "name": "saare-monorepo-root",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "clean": "powershell -Command \"Remove-Item -Recurse -Force **/dist, .turbo, .wrangler -ErrorAction SilentlyContinue\"",
    "build": "turbo run build",
    "build:all": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:console": "pnpm --filter saare-console run dev",
    "dev:landing": "pnpm --filter saare-suite run dev",
    "server": "pnpm run server:local",
    "server:local": "pnpm --filter control-plane-local dev"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.12",
    "wrangler": "^4.143.0"
  }
}