{
    "$schema":  "../node_modules/@tauri-apps/cli/schema.json",
    "productName":  "saare",
    "version":  "0.1.1",
    "identifier":  "com.saare.suite",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build",
                  "devUrl":  "http://localhost:5173",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "S.A.A.R.E. Console",
                                    "width":  1280,
                                    "height":  800
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NzI3Nzk0ODgzRjI2NjYKUldSbUpqK0lsSGR5S0pCcmd0STZBckJkNnZ4dzBpd1BnSDF6L1oways4Zy9LR2VwWDVZNkxlMloK",
                                    "endpoints":  [
                                                      "https://www.saare.es/downloads/latest.json"
                                                  ]
                                }
                }
}
