"1"="EXTENSION_ID_DE_GOOGLE_WEBSTORE;https://clients2.google.com/service/update2/crx"

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
"1"="EXTENSION_ID_DE_GOOGLE_WEBSTORE;https://clients2.google.com/service/update2/crx"
