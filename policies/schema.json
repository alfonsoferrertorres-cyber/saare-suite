{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saare.es/schemas/policy-v1.json",
  "title": "SAARE Governance Policy Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "scope",
    "effectiveFrom",
    "owner",
    "controls"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^POL[-_][A-Z0-9_]{3,32}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "ACTIVE", "DEPRECATED", "ARCHIVED"]
    },
    "scope": {
      "type": "string",
      "enum": ["GLOBAL", "TENANT_SPECIFIC", "SYSTEM_SPECIFIC"]
    },
    "tenantId": {
      "type": "string"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "reviewDate": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "format": "email"
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CTL[-_][A-Z0-9_]{3,32}$"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "action"],
        "properties": {
          "ruleId": { "type": "string" },
          "action": { "type": "string", "enum": ["ALLOW", "DENY", "AUDIT"] },
          "pattern": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}