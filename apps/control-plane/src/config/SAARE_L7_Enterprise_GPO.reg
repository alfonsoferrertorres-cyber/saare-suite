Windows Registry Editor Version 5.00

; ==============================================================================
; S.A.A.R.E. Enterprise GPO Policy - Despliegue Agnóstico Capa 7 (Zero-Touch)
; ==============================================================================

; --- 1. CONFIGURACIÓN DEL MOTOR Y TENANT L7 (S.A.A.R.E. CORE) ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\SAARE\L7]
"EnableExAnteEnforcement"=dword:00000001
"TenantId"="saare-control-plane-prod"
"TrustAnchor"="https://vault.saare.es"
"ProxyGateway"="https://api.saare.es/v1/chat/completions"

; --- 2. INSTALACIÓN FORZADA EN GOOGLE CHROME ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="agphoillkiifledmheigmmlkhmbecjhi;https://clients2.google.com/service/update2/crx"

; --- 3. INSTALACIÓN FORZADA EN MICROSOFT EDGE ---
[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist]
"1"="agphoillkiifledmheigmmlkhmbecjhi;https://clients2.google.com/service/update2/crx"