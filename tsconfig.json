{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@saare/ui/*": ["packages/ui/src/*"],
      "@saare/shared-types/*": ["packages/shared-types/src/*"],
      "@saare/assessment-engine/*": ["packages/assessment-engine/src/*"]
    }
  },
  "include": ["src", "packages", "services", "app"]
}